# local.properties.example
# Copy this file to local.properties at the project root and fill in the values.
# Never commit local.properties.

# Android SDK path. Android Studio normally creates this automatically.
# Windows example (escape backslashes):
# sdk.dir=C\:\\Users\\YourName\\AppData\\Local\\Android\\Sdk
# macOS example:
# sdk.dir=/Users/YourName/Library/Android/sdk
# Linux example:
# sdk.dir=/home/YourName/Android/Sdk

# App configuration
SERP_API_KEY=your_serp_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
